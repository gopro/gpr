        "GPR_INLINE_DENOISE_HARD": "1",
        "GPR_INLINE_DENOISE_T_LH": "2",
        "GPR_INLINE_DENOISE_T_HL": "3",
        "GPR_INLINE_DENOISE_T_HH": "3"
      },
      "quality": 8,
      "wavelet_levels": 1,
      "pixel_format": "rggb12",
      "source_width": 4096,
      "source_height": 3072,
      "use_for": "video"
    },
    "ml2_q3_l1x2": {
      "$doc": "ml2_q3 with all L1 highpass doubled (LH1/HL1: 96→192, HH1: 144→288).",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
