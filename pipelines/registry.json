        "FUSED_LL_ASSUME_U16": "1",
        "FUSED_INLINE_TOKENIZE": "1",
        "FUSED_DEFER_RANS": "1",
        "GPR_BENCH_GVID_SCATTER": "1",
        "FUSED_REFERENCE_HORIZONTAL": "1",
