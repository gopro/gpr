    "ml2_q3_dec2": {
      "$doc": "2-level FUSED q=3 with 2x2 decimation. Half-res capture, 1/4 pixels. Pair with a 2x super-res CNN on the desktop. Historical capture timing is separate from offline production selection.",
      "binary": "build-local/bin/test_fused_roundtrip",
      "env": {
        "GPR_INCLUDE_LL": "1",
        "FUSED_MULTI_LEVEL": "1",
        "FUSED_WAVELET_LEVELS": "2",
        "GPR_COL_DECIMATE": "2",
        "GPR_ROW_DECIMATE": "2"
      },
      "quality": 3,
      "use_for": "video"
    },
    "mission1_native12_t233": {
      "$doc": "Mission 1 native 12MP Bayer recompression profile: q8, one wavelet level, no decimation, exact predictive LL, FLL2/T233 highpass dead-zones LH/HL/HH=2/3/3, direct .gvid scatter write. Capture timing evidence is separate from offline reconstruction selection.",
      "binary": "build-local/bin/bench_fused",
      "env": {
        "FUSED_PIN": "1",
        "FUSED_PIN_P2": "1",
        "GPR_INCLUDE_LL": "1",
