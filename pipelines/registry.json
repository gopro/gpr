{
  "$doc": "Pipeline registry. The ONLY place where {codec, cnn, demosaicer} triples are named. Run-gate refuses to test a pipeline that isn't here. Use the full name in artifact paths, PR descriptions, and claims_log.md — never an ad-hoc short form like 'ML2_q3_CNN' (the short form was the failure mode this scaffolding exists to fix).",
  "$naming": "codec=<codec_id>+cnn=<cnn_id>+demosaic=<demosaic_id>. Hyphens within an id are fine; '+' separates the triple. If a field is absent (e.g. no CNN), use 'none' (codec=sl_q3+cnn=none+demosaic=sips).",
  "$rules": [
    "Adding a pipeline: required fields populated, no ad-hoc 'TODO' fields.",
    "Renaming a pipeline: forbidden in same PR as an artifact run. Rename + re-run in separate PRs.",
    "If you can't fill `ckpt_sha256`, you can't register the pipeline. Run `sha256sum` on the .pt file."
  ],
  "$use_for_doc": "Codec use_for retains runtime intent. Pipeline ship_class identifies the quality family, not production selection. release_selection distinguishes the eight ship roots, existing offline UPRESABLE, selected offline production, review-only candidates, and historical compatibility records.",
  "demosaicers": {
    "sips_via_gpr_tools": {
      "$doc": "Bayer plane → DNG via gpr_tools (Adobe DNG SDK preserves color matrix from source DNG params) → PNG via macOS sips (Apple's CIRawFilter). Gold standard for color science. Requires source DNG for color matrix.",
      "binary": "build-local/source/app/gpr_tools/gpr_tools",
      "needs_source_dng": true
    }
  },
  "codecs": {
    "gpr_tools_q0": {
