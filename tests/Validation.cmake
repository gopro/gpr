option(BUILD_TESTING "Enable explicitly selected validation groups" OFF)
foreach(group CODEC STILLS CONTAINER CAPTURE PREVIEW)
  option(GPR_TEST_${group} "Enable ${group} validation targets" OFF)
  if(GPR_TEST_${group} AND NOT BUILD_TESTING)
    message(FATAL_ERROR "GPR_TEST_${group} requires BUILD_TESTING=ON")
  endif()
endforeach()
include(CTest)
if(NOT BUILD_TESTING)
  return()
endif()

if(GPR_TEST_STILLS AND (NOT GPR_BUILD_SDK OR NOT GPR_BUILD_STILL_APPS))
  message(FATAL_ERROR "GPR_TEST_STILLS requires GPR_BUILD_SDK and GPR_BUILD_STILL_APPS")
endif()
if(GPR_TEST_CAPTURE AND NOT GPR_ENABLE_VIDEO)
  message(FATAL_ERROR "GPR_TEST_CAPTURE requires GPR_ENABLE_VIDEO")
endif()
if(GPR_TEST_CONTAINER AND NOT (GPR_ENABLE_VIDEO OR GPR_BUILD_PREVIEW_TOOLS))
  message(FATAL_ERROR "GPR_TEST_CONTAINER requires video or preview container support")
endif()
if(GPR_TEST_PREVIEW AND NOT GPR_BUILD_PREVIEW_TOOLS)
  message(FATAL_ERROR "GPR_TEST_PREVIEW requires GPR_BUILD_PREVIEW_TOOLS")
endif()
if(WIN32 AND (GPR_TEST_CODEC OR GPR_TEST_CAPTURE OR GPR_TEST_PREVIEW))
  message(FATAL_ERROR "Codec, capture and preview tests require POSIX")
endif()

if(GPR_TEST_STILLS)
  add_subdirectory(source/app/compare_quality)
endif()
if(GPR_TEST_CAPTURE)
  gpr_native_tool(test_video_pipeline_sim_portable source/app/test_video_pipeline_sim_portable.c)
  foreach(test_name test_labs_encoder_api test_video_encoder_abort test_video_full_chain)
    gpr_native_tool(${test_name} source/app/${test_name}.c)
    target_compile_definitions(${test_name} PRIVATE _POSIX_C_SOURCE=200809L)
    add_test(NAME ${test_name} COMMAND ${test_name})
    set_tests_properties(${test_name} PROPERTIES TIMEOUT 60 LABELS capture)
  endforeach()
endif()
if(GPR_TEST_CONTAINER)
  gpr_native_tool(test_video_format source/app/test_video_format.c)
  add_test(NAME gvid_format COMMAND test_video_format)
  set_tests_properties(gvid_format PROPERTIES LABELS container TIMEOUT 60)
endif()
if(GPR_TEST_CODEC)
  gpr_native_tool(test_fused_roundtrip source/app/test_fused_decode_roundtrip.c)
  gpr_native_tool(test_fused_band_roundtrip source/app/test_fused_roundtrip.c)
  add_test(NAME fused_band_roundtrip COMMAND test_fused_band_roundtrip)
  set_tests_properties(fused_band_roundtrip PROPERTIES TIMEOUT 60 LABELS codec
    ENVIRONMENT "GPR_INCLUDE_LL=0;GPR_ROW_DECIMATE=1;GPR_COL_DECIMATE=1;GPR_DROP_HIGHPASS=0;FUSED_INLINE_TOKENIZE=0")
  gpr_native_tool(test_edge_sizes source/app/test_edge_sizes.c)
  gpr_native_tool(test_fused_pool_drop_hp source/app/test_fused_pool_drop_hp.c
    source/lib/vc5_encoder/fused_encode.c)
  target_compile_definitions(test_fused_pool_drop_hp PRIVATE PASS2_POOL_FORCE=1)
  add_test(NAME fused_pool_drop_hp COMMAND test_fused_pool_drop_hp)
  add_test(NAME fused_edges_split COMMAND test_edge_sizes)
  set_tests_properties(fused_edges_split PROPERTIES ENVIRONMENT "FUSED_INLINE_TOKENIZE=0")
  add_test(NAME fused_edges_inline COMMAND test_edge_sizes)
  set_tests_properties(fused_edges_inline PROPERTIES ENVIRONMENT "FUSED_INLINE_TOKENIZE=1")
  add_executable(test_jans_inline_tail_flush source/app/test_jans_inline_tail_flush.c)
  target_include_directories(test_jans_inline_tail_flush PRIVATE source/lib/vc5_common)
  target_link_libraries(test_jans_inline_tail_flush vc5_common common)
  if(NOT WIN32)
    target_link_libraries(test_jans_inline_tail_flush m)
  endif()
  set_target_properties(test_jans_inline_tail_flush PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
  add_test(NAME entropy_inline_tail_flush COMMAND test_jans_inline_tail_flush)
  set_tests_properties(fused_pool_drop_hp fused_edges_split fused_edges_inline
    entropy_inline_tail_flush PROPERTIES TIMEOUT 60 LABELS codec)
endif()

if(GPR_TEST_STILLS OR GPR_TEST_PREVIEW)
  find_package(PythonInterp 3 REQUIRED)
  function(gpr_python_test name script label)
    add_test(NAME ${name} COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/${script}" ${ARGN})
    set(test_environment "BUILD_DIR=${CMAKE_BINARY_DIR}")
    if(TARGET gpr_tools)
      list(APPEND test_environment "GPR_TOOLS=$<TARGET_FILE:gpr_tools>")
    endif()
    set_tests_properties(${name} PROPERTIES LABELS ${label} TIMEOUT 300
      ENVIRONMENT "${test_environment}")
  endfunction()
  if(GPR_TEST_STILLS)
    gpr_python_test(still_metadata tools/test/test_still_metadata.py stills)
  endif()
  if(GPR_TEST_PREVIEW)
    gpr_native_tool(test_preview_fixture source/app/test_preview_fixture.c)
    gpr_python_test(native_preview tools/test/test_native_preview.py preview
      --preview-bin $<TARGET_FILE:gvid_preview_rgb_cli>
      --fixture-bin $<TARGET_FILE:test_preview_fixture>)
  endif()
endif()
