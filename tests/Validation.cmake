option(BUILD_TESTING "Enable explicitly selected validation groups" OFF)
foreach(group STILLS)
  option(GPR_TEST_${group} "Enable ${group} validation targets" OFF)
  if(GPR_TEST_${group} AND NOT BUILD_TESTING)
    message(FATAL_ERROR "GPR_TEST_${group} requires BUILD_TESTING=ON")
  endif()
endforeach()
include(CTest)
if(NOT BUILD_TESTING)
  return()
endif()

if(GPR_TEST_STILLS AND (NOT GPR_BUILD_SDK OR NOT GPR_BUILD_STILL_APPS))
  message(FATAL_ERROR "GPR_TEST_STILLS requires GPR_BUILD_SDK and GPR_BUILD_STILL_APPS")
endif()

if(GPR_TEST_STILLS)
  add_subdirectory(source/app/compare_quality)
endif()

if(GPR_TEST_STILLS)
  find_package(PythonInterp 3 REQUIRED)
  function(gpr_python_test name script label)
    add_test(NAME ${name} COMMAND "${PYTHON_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/${script}" ${ARGN})
    set(test_environment "BUILD_DIR=${CMAKE_BINARY_DIR}")
    if(TARGET gpr_tools)
      list(APPEND test_environment "GPR_TOOLS=$<TARGET_FILE:gpr_tools>")
    endif()
    set_tests_properties(${name} PROPERTIES LABELS ${label} TIMEOUT 300
      ENVIRONMENT "${test_environment}")
  endfunction()
  if(GPR_TEST_STILLS)
    gpr_python_test(still_metadata tools/test/test_still_metadata.py stills)
  endif()
endif()
